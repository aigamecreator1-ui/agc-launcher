# Copy this file to .env and fill in real values. .env is gitignored; this
# template is safe to commit so the required variables are documented.

# Postgres connection string (e.g. from Neon — dashboard.neon.tech, free tier, no
# card required). Use the "pooled" connection string Neon provides if given a choice.
# Format: Host=...;Database=...;Username=...;Password=...;SSL Mode=Require
DATABASE_URL=

# Supabase Storage (supabase.com, free tier, no card required) — holds uploaded game
# builds and thumbnails. SUPABASE_URL is the project URL shown on the project's
# dashboard home ("Project URL"); SUPABASE_SERVICE_ROLE_KEY is under
# Project Settings -> API -> service_role secret (NOT the anon/public key — this one
# bypasses Row Level Security and must never reach the desktop client).
# SUPABASE_BUCKET is whatever you name the storage bucket you create (e.g. "game-files").
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# Stripe (use test-mode keys from https://dashboard.stripe.com/test/apikeys during development)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# From `stripe listen --forward-to http://localhost:5137/api/webhooks/stripe` (Stripe CLI)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Static bypass code for owner-account login
OWNER_SECURITY_CODE=
OWNER_EMAIL=

# Generate with: openssl rand -base64 48   (or any random 48+ byte secret)
JWT_SIGNING_KEY=

# resend.com — leave RESEND_API_KEY blank to use dev-mode codes (logged to console
# and echoed to the client) instead of real emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=AGC Launcher <onboarding@resend.dev>

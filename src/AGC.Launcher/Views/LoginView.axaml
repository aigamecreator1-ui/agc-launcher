<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AGC.Launcher.ViewModels"
             xmlns:controls="using:AGC.Launcher.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
             x:Class="AGC.Launcher.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="32,28" Spacing="10">
            <Image Source="/Assets/Images/agc_logo.png" Height="30" Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="AGC // LAUNCHER" Classes="mono muted" FontSize="12" LetterSpacing="2" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
            <controls:HudCorners Brush="{StaticResource AccentCyanBrush}" BracketLength="18" Margin="-10" />
            <controls:AngularBorder Background="#CC0B0F14"
                                     BorderBrush="{StaticResource BorderDimBrush}"
                                     BorderThickness="1"
                                     CornerCut="16"
                                     Padding="40,36">
                <StackPanel Spacing="22">

                    <StackPanel Spacing="14" HorizontalAlignment="Center">
                        <Image Source="/Assets/Images/agc_logo.png" Height="88" Stretch="Uniform"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="SECURE ACCESS" Classes="eyebrow" HorizontalAlignment="Center" />
                            <TextBlock Text="SIGN IN" Classes="headline" FontSize="34" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <Border Classes="divider" />

                    <!-- Step 1: email -->
                    <StackPanel Spacing="10" IsVisible="{Binding IsEmailStage}">
                        <TextBlock Text="EMAIL ADDRESS" Classes="eyebrow" FontSize="10" />
                        <TextBox Text="{Binding Email}" PlaceholderText="you@example.com" />
                        <Button Content="CONTINUE"
                                Command="{Binding ContinueWithEmailCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Classes="cta" />
                        <Button Content="DON'T HAVE AN ACCOUNT? SIGN UP"
                                Command="{Binding GoToSignUpCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Classes="ghost" FontSize="11" />
                    </StackPanel>

                    <!-- Step 2: verification code (normal accounts) -->
                    <StackPanel Spacing="10" IsVisible="{Binding IsCodeStage}">
                        <TextBlock Classes="muted" FontSize="13">
                            <Run Text="CODE SENT TO" />
                            <Run Text="{Binding Email}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBox Text="{Binding Code}"
                                  PlaceholderText="000000"
                                  MaxLength="6"
                                  HorizontalContentAlignment="Center"
                                  Classes="mono-input" />

                        <controls:AngularBorder IsVisible="{Binding DevModeCodeHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                 Background="#1A2BE0FF"
                                                 BorderBrush="{StaticResource AccentCyanDimBrush}"
                                                 BorderThickness="1"
                                                 CornerCut="6"
                                                 Padding="12,8">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Classes="mono">
                                <Run Text="DEV MODE — NO EMAIL SENT. CODE:" Foreground="{StaticResource TextMutedBrush}" />
                                <Run Text="{Binding DevModeCodeHint}" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" />
                            </TextBlock>
                        </controls:AngularBorder>

                        <Button Content="VERIFY &amp; AUTHENTICATE"
                                Command="{Binding VerifyCodeCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Classes="cta" />
                        <Button Content="USE A DIFFERENT EMAIL"
                                Command="{Binding BackToEmailCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Classes="ghost" />
                    </StackPanel>

                    <!-- Step 2 (owner path): security code, not emailed -->
                    <StackPanel Spacing="10" IsVisible="{Binding IsOwnerCodeStage}">
                        <TextBlock Text="OWNER SECURITY CODE" Classes="eyebrow" FontSize="10" />
                        <TextBox Text="{Binding Code}"
                                  PlaceholderText="000000"
                                  MaxLength="6"
                                  HorizontalContentAlignment="Center"
                                  Classes="mono-input"
                                  PasswordChar="•" />

                        <Button Content="VERIFY &amp; AUTHENTICATE"
                                Command="{Binding VerifyOwnerCodeCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Classes="cta" />
                        <Button Content="USE A DIFFERENT EMAIL"
                                Command="{Binding BackToEmailCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Classes="ghost" />
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Classes="error"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />

                </StackPanel>
            </controls:AngularBorder>
        </Grid>

        <TextBlock Grid.Row="2" Text="AIGAMECREATOR STUDIO" Classes="faint mono" HorizontalAlignment="Center" Margin="0,0,0,24" LetterSpacing="2" />

    </Grid>
</UserControl>

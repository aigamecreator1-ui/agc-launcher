<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AGC.Launcher.ViewModels"
             xmlns:controls="using:AGC.Launcher.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
             x:Class="AGC.Launcher.Views.OwnerGamesView"
             x:DataType="vm:OwnerGamesViewModel">

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="{StaticResource SpaceXl}">

            <StackPanel Spacing="6">
                <TextBlock Text="OWNER" Classes="eyebrow" />
                <TextBlock Text="GAMES" Classes="headline" FontSize="30" />
                <TextBlock Text="Every title currently published on the platform." Classes="muted" FontSize="12" />
            </StackPanel>

            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
            <TextBlock Text="{Binding ErrorMessage}" Classes="error" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <TextBlock Text="NOTHING PUBLISHED YET" Classes="eyebrow"
                       IsVisible="{Binding !HasAnyGames}" Margin="0,20" />

            <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OwnerGameItemViewModel">
                        <Grid Width="300" Margin="0,0,20,20" Classes="game-card">
                            <controls:HudCorners Brush="{StaticResource AccentCyanBrush}" BracketLength="14" Margin="-8" />
                            <controls:AngularBorder Classes="card-chrome"
                                                     Background="{StaticResource PanelBrush}"
                                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                                     BorderThickness="1"
                                                     CornerCut="14"
                                                     Padding="0">
                                <Grid>
                                    <StackPanel>
                                        <Panel Height="130" ClipToBounds="True">
                                            <Border Background="{StaticResource PanelAltBrush}" />
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                   IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </Panel>

                                        <StackPanel Margin="18,16,18,16" Spacing="10">
                                            <TextBlock Text="{Binding Game.Title}" Classes="card-title"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="230" />

                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding PriceDisplay}"
                                                           Classes="stat" FontSize="15" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding OwnerCountDisplay}"
                                                           Classes="mono muted" FontSize="10" VerticalAlignment="Center" />
                                            </Grid>

                                            <TextBlock Text="{Binding RevenueDisplay}" Classes="mono muted" FontSize="10"
                                                       IsVisible="{Binding RevenueDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                            <!-- Delete confirmation -->
                                            <StackPanel Spacing="8" IsVisible="{Binding IsConfirmingDelete}">
                                                <Border Classes="divider" />
                                                <TextBlock Text="{Binding ConfirmPrompt}" Classes="error"
                                                           TextWrapping="Wrap" FontSize="11" />
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <Button Grid.Column="0" Content="CANCEL"
                                                            Command="{Binding CancelDeleteCommand}"
                                                            IsEnabled="{Binding !IsDeleting}"
                                                            Classes="ghost" Padding="0,7" FontSize="11"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                                    <Button Grid.Column="1" Content="DELETE"
                                                            Command="{Binding ConfirmDeleteCommand}"
                                                            Classes="cta" Padding="0,7" FontSize="11"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="DELETING — CLOSING LAUNCHER FOR ALL USERS..." Classes="mono muted"
                                                           FontSize="9" LetterSpacing="0.5" TextWrapping="Wrap"
                                                           IsVisible="{Binding IsDeleting}" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding ErrorMessage}" Classes="error" TextWrapping="Wrap"
                                                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- "..." menu -->
                                    <Button Content="&#8942;" Classes="ghost" FontSize="16" Padding="8,2"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                            Command="{Binding ToggleMenuCommand}"
                                            IsVisible="{Binding !IsConfirmingDelete}" />

                                    <Border IsVisible="{Binding IsMenuOpen}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,10,0"
                                            Background="{StaticResource PanelAltBrush}"
                                            BorderBrush="{StaticResource BorderDimBrush}" BorderThickness="1"
                                            Padding="4" MinWidth="120">
                                        <Button Content="DELETE" Classes="ghost" FontSize="11"
                                                Foreground="{StaticResource DangerBrush}"
                                                Command="{Binding RequestDeleteCommand}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="10,7" />
                                    </Border>
                                </Grid>
                            </controls:AngularBorder>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>

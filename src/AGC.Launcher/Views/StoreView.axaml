<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AGC.Launcher.ViewModels"
             xmlns:controls="using:AGC.Launcher.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="AGC.Launcher.Views.StoreView"
             x:DataType="vm:StoreViewModel">

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="{StaticResource SpaceXl}">

            <StackPanel Spacing="6">
                <TextBlock Text="CATALOG" Classes="eyebrow" />
                <TextBlock Text="STORE" Classes="headline" FontSize="30" />
            </StackPanel>

            <!-- Hero / featured banner -->
            <Grid IsVisible="{Binding FeaturedGame, Converter={x:Static ObjectConverters.IsNotNull}}">
                <controls:HudCorners Brush="{StaticResource AccentCyanBrush}" BracketLength="20" Margin="-10" />
                <controls:AngularBorder Background="{StaticResource PanelAltBrush}"
                                         BorderBrush="{StaticResource BorderSubtleBrush}"
                                         BorderThickness="1"
                                         CornerCut="18"
                                         Padding="0">
                    <Grid ColumnDefinitions="1.4*,*" Height="260">

                        <Button Grid.Column="0" Classes="card-hit" Command="{Binding FeaturedGame.OpenDetailCommand}">
                            <Panel ClipToBounds="True">
                                <Border Background="{StaticResource PanelAltBrush}" />
                                <Image Source="{Binding FeaturedGame.Thumbnail}" Stretch="UniformToFill"
                                       IsVisible="{Binding FeaturedGame.Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <Border Background="{StaticResource HeroScrimBrush}" />

                                <StackPanel VerticalAlignment="Bottom" Margin="32,0,24,28" Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="chip">
                                            <TextBlock Text="FEATURED" Classes="chip-text" Foreground="{StaticResource AccentCyanBrush}" />
                                        </Border>
                                        <Border Classes="chip" IsVisible="{Binding FeaturedGame.Game.Genre, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="{Binding FeaturedGame.Game.Genre}" Classes="chip-text" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FeaturedGame.Game.Title}" Classes="headline" FontSize="36" />
                                    <TextBlock Text="{Binding FeaturedGame.Game.Description}" Classes="card-desc"
                                               FontSize="13" TextWrapping="Wrap" MaxWidth="480" MaxLines="2" />
                                </StackPanel>
                            </Panel>
                        </Button>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" Margin="24">
                            <TextBlock Text="{Binding FeaturedGame.PriceDisplay}" Classes="stat" FontSize="26" HorizontalAlignment="Center" />

                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                                        IsVisible="{Binding FeaturedGame.IsOwned}">
                                <Border Classes="hud-dot" />
                                <TextBlock Text="OWNED" Classes="mono muted" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Content="{Binding FeaturedGame.BuyLabel}" Command="{Binding FeaturedGame.BuyCommand}"
                                    IsVisible="{Binding !FeaturedGame.IsOwned}"
                                    Classes="cta" Padding="26,12" FontSize="13" />

                            <Button Content="VIEW DETAILS" Command="{Binding FeaturedGame.OpenDetailCommand}"
                                    Classes="ghost" Padding="20,9" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </controls:AngularBorder>
            </Grid>

            <!-- Search + filter -->
            <Grid ColumnDefinitions="*,220" ColumnSpacing="{StaticResource SpaceMd}">
                <TextBox Grid.Column="0" Classes="search" Text="{Binding SearchText}" PlaceholderText="SEARCH GAMES..." />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Genres}" SelectedItem="{Binding SelectedGenre}"
                          HorizontalAlignment="Stretch" />
            </Grid>

            <TextBlock Text="NO GAMES MATCH YOUR SEARCH" Classes="eyebrow" IsVisible="{Binding !Games.Count}" Margin="0,20" />

            <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StoreGameItemViewModel">
                        <Grid Width="300" Margin="0,0,20,20" Classes="game-card">
                            <controls:HudCorners Brush="{StaticResource AccentCyanBrush}" BracketLength="14" Margin="-8" />
                            <controls:AngularBorder Classes="card-chrome"
                                                     Background="{StaticResource PanelBrush}"
                                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                                     BorderThickness="1"
                                                     CornerCut="14"
                                                     Padding="0">
                                <StackPanel>
                                    <Button Classes="card-hit" Command="{Binding OpenDetailCommand}">
                                        <StackPanel>
                                            <Panel Height="130" ClipToBounds="True">
                                                <Border Background="{StaticResource PanelAltBrush}" />
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                       IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </Panel>

                                            <StackPanel Margin="18,16,18,0" Spacing="8">
                                                <TextBlock Text="{Binding Game.Title}" Classes="card-title" TextTrimming="CharacterEllipsis" />
                                                <Panel Height="34" ClipToBounds="True">
                                                    <TextBlock Text="{Binding Game.Description}" TextWrapping="Wrap" Classes="card-desc" />
                                                </Panel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <StackPanel Margin="18,10,18,16" Spacing="10">
                                        <TextBlock Text="{Binding ErrorMessage}" Classes="error"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                        <Border Classes="divider" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding PriceDisplay}"
                                                       Classes="stat" FontSize="17" VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                        IsVisible="{Binding IsOwned}">
                                                <Border Classes="hud-dot" />
                                                <TextBlock Text="OWNED" Classes="mono muted" FontSize="11" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="{Binding BuyLabel}"
                                                    Command="{Binding BuyCommand}"
                                                    IsVisible="{Binding !IsOwned}"
                                                    Padding="18,8" FontSize="12"
                                                    Classes="cta" />
                                        </Grid>

                                        <StackPanel Spacing="4" IsVisible="{Binding IsPurchasing}">
                                            <ProgressBar IsIndeterminate="True" />
                                            <TextBlock Text="{Binding PurchasingStatus}" Classes="mono muted" FontSize="10" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </controls:AngularBorder>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
